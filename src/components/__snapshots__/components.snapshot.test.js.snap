// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`Card folded cards get the folded class and a zeroed animation delay 1`] = `"<div class=\\"playing-card cardIn  folded\\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:red\\">A ♥</h6></div>"`;

exports[`Card renders a black suit 1`] = `"<div class=\\"playing-card cardIn \\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:black\\">10 ♠</h6></div>"`;

exports[`Card renders a red suit with its animation delay 1`] = `"<div class=\\"playing-card cardIn \\" style=\\"animation-delay:250ms\\"><h6 style=\\"color:red\\">A ♥</h6></div>"`;

exports[`HiddenCard renders a face-down robot card 1`] = `"<div class=\\"playing-card cardIn robotcard\\" style=\\"animation-delay:250ms\\"></div>"`;

exports[`Player marks folded players cards 1`] = `"<div class=\\"player-entity--wrapper p0\\"><div class=\\"actionBox\\">null</div><div class=\\"centered-flex-row abscard\\"><div class=\\"playing-card cardIn  folded\\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:red\\">A ♥</h6></div><div class=\\"playing-card cardIn  folded\\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:red\\">K ♦</h6></div></div><div class=\\"player-entity--container\\"><div class=\\"player-avatar--container\\"><img class=\\"player-avatar--image\\" src=\\"/assets/boy.svg\\" alt=\\"Player Avatar\\"/><h5 class=\\"player-info--name\\" style=\\"font-size:12px\\">Player 1</h5><div class=\\"player-info--stash--container\\"><img class=\\"player-info--stash--image\\" src=\\"./assets/chips.svg\\" alt=\\"Player Stash\\"/><h5>19500</h5></div><div class=\\"player-info--bet--container\\"><img class=\\"player-info--bet--image\\" src=\\"./assets/bet.svg\\" alt=\\"Player Bet\\"/><h5>Bet: 500</h5></div></div></div></div>"`;

exports[`Player renders robot cards face-down before showdown 1`] = `"<div class=\\"player-entity--wrapper p0\\"><div class=\\"actionBox\\">null</div><div class=\\"centered-flex-row abscard\\"><div class=\\"playing-card cardIn robotcard\\" style=\\"animation-delay:0ms\\"></div><div class=\\"playing-card cardIn robotcard\\" style=\\"animation-delay:250ms\\"></div></div><div class=\\"player-entity--container\\"><div class=\\"player-avatar--container\\"><img class=\\"player-avatar--image\\" src=\\"/assets/boy.svg\\" alt=\\"Player Avatar\\"/><h5 class=\\"player-info--name\\" style=\\"font-size:12px\\">Robo</h5><div class=\\"player-info--stash--container\\"><img class=\\"player-info--stash--image\\" src=\\"./assets/chips.svg\\" alt=\\"Player Stash\\"/><h5>19500</h5></div><div class=\\"player-info--bet--container\\"><img class=\\"player-info--bet--image\\" src=\\"./assets/bet.svg\\" alt=\\"Player Bet\\"/><h5>Bet: 500</h5></div></div></div></div>"`;

exports[`Player renders the human player with revealed cards, active ring, and dealer chip 1`] = `"<div class=\\"player-entity--wrapper p0\\"><div class=\\"actionBox\\">null</div><div class=\\"centered-flex-row abscard\\"><div class=\\"playing-card cardIn \\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:red\\">A ♥</h6></div><div class=\\"playing-card cardIn \\" style=\\"animation-delay:250ms\\"><h6 style=\\"color:red\\">K ♦</h6></div></div><div class=\\"player-entity--container\\"><div class=\\"player-avatar--container\\"><img class=\\"player-avatar--image activePlayer\\" src=\\"/assets/boy.svg\\" alt=\\"Player Avatar\\"/><h5 class=\\"player-info--name\\" style=\\"font-size:12px\\">Player 1</h5><div class=\\"player-info--stash--container\\"><img class=\\"player-info--stash--image\\" src=\\"./assets/chips.svg\\" alt=\\"Player Stash\\"/><h5>19500</h5></div><div class=\\"player-info--bet--container\\"><img class=\\"player-info--bet--image\\" src=\\"./assets/bet.svg\\" alt=\\"Player Bet\\"/><h5>Bet: 500</h5></div><div class=\\"dealer-chip-icon-container\\"><img src=\\"/assets/chip.svg\\" alt=\\"Dealer Chip\\"/></div></div></div></div>"`;

exports[`Player reveals robot cards at showdown 1`] = `"<div class=\\"player-entity--wrapper p0\\"><div class=\\"actionBox\\">null</div><div class=\\"centered-flex-row abscard\\"><div class=\\"playing-card cardIn \\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:red\\">A ♥</h6></div><div class=\\"playing-card cardIn \\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:red\\">K ♦</h6></div></div><div class=\\"player-entity--container\\"><div class=\\"player-avatar--container\\"><img class=\\"player-avatar--image\\" src=\\"/assets/boy.svg\\" alt=\\"Player Avatar\\"/><h5 class=\\"player-info--name\\" style=\\"font-size:12px\\">Robo</h5><div class=\\"player-info--stash--container\\"><img class=\\"player-info--stash--image\\" src=\\"./assets/chips.svg\\" alt=\\"Player Stash\\"/><h5>19500</h5></div><div class=\\"player-info--bet--container\\"><img class=\\"player-info--bet--image\\" src=\\"./assets/bet.svg\\" alt=\\"Player Bet\\"/><h5>Bet: 500</h5></div></div></div></div>"`;

exports[`PlayerStatusNotificationBox renders the action bubble content 1`] = `"<div class=\\"actionBox\\">Raise 500</div>"`;

exports[`ShowdownPlayer renders the avatar and revealed private cards 1`] = `"<div class=\\"player-entity--container\\"><div class=\\"player-avatar--container\\"><img class=\\"player-avatar--image\\" src=\\"/assets/boy.svg\\" alt=\\"Player Avatar\\"/><h5 class=\\"player-info--name\\">Player 1</h5></div><div class=\\"showdownPlayer--privateCards\\"><h5 class=\\"showdownPlayer--cards--heading\\">Private Cards</h5><div class=\\"showdownPlayer--cards\\"><div class=\\"playing-card cardIn \\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:red\\">A ♥</h6></div><div class=\\"playing-card cardIn \\" style=\\"animation-delay:0ms\\"><h6 style=\\"color:red\\">K ♦</h6></div></div></div></div>"`;
